{
  "name": "mygameio",
  "version": "0.1.0",
  "description": "Agar.io-подобная игра с ловушками, способностями, эволюцией и опасностями на карте",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "server": "node server/server.js",
    "dev": "sdk-dev-proxy -p . --dev-mode=true --port=8080",
    "dev:prod": "sdk-dev-proxy -p . --port=8080",
    "dev:proxy": "sdk-dev-proxy -h http://localhost:8765 --dev-mode=true"
  },
  "keywords": [
    "game",
    "agar",
    "io",
    "canvas",
    "multiplayer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KKirillAzizyan/mygameio.git"
  },
  "devDependencies": {
    "@yandex-games/sdk-dev-proxy": "^0.0.2"
  }
}
